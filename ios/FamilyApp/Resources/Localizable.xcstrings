    "role.adult.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sees and adds expenses, tasks and notes. Can't manage members or budgets."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê e adiciona despesas, tarefas e notas. Não gere membros nem orçamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видит и добавляет расходы, задачи и заметки. Не управляет участниками и бюджетами."
          }
        }
      }
    },
