    "mfa.enroll.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family data is protected by a second factor. Add a one-time code to Passwords (or any authenticator app) once — then the code fills in automatically."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados da família estão protegidos por um segundo fator. Adicione o código uma vez às Palavras-passe (ou a uma app autenticadora) — depois o código é preenchido automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные семьи защищены вторым фактором. Один раз добавьте код в «Пароли» (или любое приложение-аутентификатор) — дальше код будет подставляться автоматически."
          }
        }
      }
    },
